# Reviewed NEWMAR-002 request bundle candidate evidence only for NEWMAR-003+.
# KAH must block unsafe provider execution before KAH consumes it.
# no inferred defaults
# no generated semantic prompt text
schema_version: kas.mar.request_bundle.v1
task_id: "{{ task_id }}"
run_id: "{{ run_id }}"
request_metadata:
  request_id: "{{ request_id }}"
  requested_at: "{{ requested_at }}"
  request_kind: "role_first_review"
  source_authority: "KAS"
  candidate_evidence_only: true
  review_surface:
    ref:
      path: "{{ review_surface_path }}"
      sha256: "{{ review_surface_sha256 }}"
    git_head: "{{ review_git_head }}"
role_matrix:
  required_roles: {{ required_roles_yaml }}
  role_bindings: {{ role_bindings_yaml }}
prompt_refs: {{ prompt_refs_yaml }}
input_bundle_ref:
  path: "{{ input_bundle_path }}"
  sha256: "{{ input_bundle_sha256 }}"
provider_registry:
  schema_version: kas.mar.provider_registry_correlation.v1
  ref:
    path: "{{ provider_registry_path }}"
    sha256: "{{ provider_registry_sha256 }}"
  correlation_ref:
    path: "{{ provider_correlation_path }}"
    sha256: "{{ provider_correlation_sha256 }}"
  snapshot_sha256: "{{ provider_registry_sha256 }}"
approval_binding:
  mar_start:
    approval_ref: "{{ approval_ref }}"
    task_id: "{{ task_id }}"
    run_id: "{{ run_id }}"
    review_git_head: "{{ review_git_head }}"
    input_bundle_sha256: "{{ input_bundle_sha256 }}"
    provider_registry_sha256: "{{ provider_registry_sha256 }}"
    requested_at: "{{ requested_at }}"
    bound_tuple:
      task_id: "{{ task_id }}"
      run_id: "{{ run_id }}"
      request_bundle_schema_version: kas.mar.request_bundle.v1
      request_bundle_ref:
        path: "{{ request_bundle_path }}"
        sha256: "{{ request_bundle_sha256 }}"
      request_schema_ref:
        path: "{{ request_schema_path }}"
        sha256: "{{ request_schema_sha256 }}"
      input_bundle_ref:
        path: "{{ input_bundle_path }}"
        sha256: "{{ input_bundle_sha256 }}"
      role_matrix_ref:
        path: "{{ role_matrix_path }}"
        sha256: "{{ role_matrix_sha256 }}"
      prompt_refs_sha256: "{{ prompt_refs_sha256 }}"
      prompt_bundle_refs: {{ prompt_refs_yaml }}
      required_roles: {{ required_roles_yaml }}
      provider_lane_id: "{{ provider_lane_id }}"
      provider_id: "{{ provider_id }}"
      provider_family: "{{ provider_family }}"
      adapter_type: "{{ adapter_type }}"
      adapter_proof_ref:
        path: "{{ adapter_proof_path }}"
        sha256: "{{ adapter_proof_sha256 }}"
      provider_registry_schema_version: mar.role_lanes.v1
      provider_registry_ref:
        path: "{{ provider_registry_path }}"
        sha256: "{{ provider_registry_sha256 }}"
      provider_correlation_ref:
        path: "{{ provider_correlation_path }}"
        sha256: "{{ provider_correlation_sha256 }}"
      provider_provenance_ref:
        path: "{{ provider_provenance_path }}"
        sha256: "{{ provider_provenance_sha256 }}"
      provider_preflight_ref:
        path: "{{ provider_preflight_path }}"
        sha256: "{{ provider_preflight_sha256 }}"
        valid_through_request_ts: "{{ valid_through_request_ts }}"
      provider_preflight:
        ref:
          path: "{{ provider_preflight_path }}"
          sha256: "{{ provider_preflight_sha256 }}"
        generated_at: "{{ provider_preflight_generated_at }}"
        expires_at: "{{ provider_preflight_expires_at }}"
        checked_binary_version: "{{ checked_binary_version }}"
        checked_capability_version: "{{ checked_capability_version }}"
      required_capabilities: {{ required_capabilities_yaml }}
      author_backend_correlation:
        author_backend_id: "{{ author_backend_id }}"
        author_backend_family: "{{ author_backend_family }}"
        author_session_ref: {{ author_session_ref_yaml }}
        author_thread_ref: {{ author_thread_ref_yaml }}
        author_turn_ref: {{ author_turn_ref_yaml }}
        correlation_status: "{{ correlation_status }}"
        independence_policy_ref:
          path: "{{ independence_policy_path }}"
          sha256: "{{ independence_policy_sha256 }}"
      execution_policy_refs:
        concurrency_policy_ref:
          path: "{{ concurrency_policy_path }}"
          sha256: "{{ concurrency_policy_sha256 }}"
        duration_policy_ref:
          path: "{{ duration_policy_path }}"
          sha256: "{{ duration_policy_sha256 }}"
        cost_policy_ref:
          path: "{{ cost_policy_path }}"
          sha256: "{{ cost_policy_sha256 }}"
        independence_policy_ref:
          path: "{{ independence_policy_path }}"
          sha256: "{{ independence_policy_sha256 }}"
        execution_safety_ref:
          path: "{{ execution_safety_policy_path }}"
          sha256: "{{ execution_safety_policy_sha256 }}"
      execution_policy_values:
        max_concurrency: {{ max_concurrency }}
        max_duration: "{{ max_duration }}"
        max_cost_or_token_budget: "{{ max_cost_or_token_budget }}"
        raw_output_cap: "{{ raw_output_cap }}"
        secret_scan_redaction_required: true
        mutation_guard_required: true
        safety_policy_ref:
          path: "{{ execution_safety_policy_path }}"
          sha256: "{{ execution_safety_policy_sha256 }}"
      approval_metadata_ref:
        path: "{{ approval_metadata_path }}"
        sha256: "{{ approval_metadata_sha256 }}"
      approval_metadata:
        approval_posture: "{{ approval_posture }}"
        approver_id: "{{ approver_id }}"
        approval_ref_id: "{{ approval_ref }}"
        approval_scope: "{{ approval_scope }}"
        approved_tuple_checksum: "{{ approved_tuple_checksum }}"
        approval_created_at: "{{ approval_created_at }}"
        approval_expires_at: "{{ approval_expires_at }}"
        retry_waiver_approval_ref:
          path: "{{ retry_waiver_path }}"
          sha256: "{{ retry_waiver_sha256 }}"
        null_validation_posture: "{{ null_validation_posture }}"
      approved_tuple_checksum: "{{ approved_tuple_checksum }}"
      approval_expires_at: "{{ approval_expires_at }}"
      retry_waiver_approval_ref:
        path: "{{ retry_waiver_path }}"
        sha256: "{{ retry_waiver_sha256 }}"
retry_waiver_approval_ref:
  path: "{{ retry_waiver_path }}"
  sha256: "{{ retry_waiver_sha256 }}"
policy_refs:
  concurrency_policy_ref:
    path: "{{ concurrency_policy_path }}"
    sha256: "{{ concurrency_policy_sha256 }}"
  duration_policy_ref:
    path: "{{ duration_policy_path }}"
    sha256: "{{ duration_policy_sha256 }}"
  cost_policy_ref:
    path: "{{ cost_policy_path }}"
    sha256: "{{ cost_policy_sha256 }}"
  independence_policy_ref:
    path: "{{ independence_policy_path }}"
    sha256: "{{ independence_policy_sha256 }}"
  execution_safety_ref:
    path: "{{ execution_safety_policy_path }}"
    sha256: "{{ execution_safety_policy_sha256 }}"
execution_safety:
  fail_closed_on_stale_or_mismatch: true
  block_provider_execution_until_kah_capability_match: true
  no_generated_semantic_prompt_text: true
  unsafe_ref_policy: reject
  extra_unreviewed_metadata_policy: reject
