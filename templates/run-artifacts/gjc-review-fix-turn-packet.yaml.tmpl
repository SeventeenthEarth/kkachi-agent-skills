schema_version: kas.gajae_gjc_packet.v1
packet_kind: review_fix_turn
task_id: "{{ task_id }}"
run_id: "{{ run_id }}"

source_command:
  korean: "{{ korean_source_command }}"
  role: "source-of-truth command text; do not translate or replace it."

gjc_operational_brief_english: |
  Run a bounded GJC review/fix turn for accepted review or MAR findings only.
  Preserve finding refs, changed-surface limits, and run-local artifact_refs for
  the candidate fix evidence. KAT evidence for review/fix turns is deferred
  until KAH implements a review-fix command/status path; if separately
  supported later, preserve KAT status, summary, raw-log refs, hashes,
  extractor status, command exit code, and run-id linkage as factual evidence
  only.

authority_boundaries:
  owner: KAS/Blue/color/MAR/final
  rule: "GJC may propose or apply a candidate fix only inside accepted findings; KAS/Blue/color/MAR/final decide disposition."
  kah_role: "KAH validates packet_ref and artifact_refs mechanically only."
  no_acceptance_by_gjc: true

stop_ask_gates:
  ask_required_when:
    - "finding disposition is unclear"
    - "fix would exceed accepted review/MAR scope"
    - "new authority or non-goal waiver is needed"
  stop_required_when:
    - "packet_ref is missing, stale, or checksum-mismatched"
    - "accepted finding refs are missing"
    - "hidden fallback or warning-only review handling would be needed"

plan_lock:
  required_before_implementation: true
  accepted_plan_hash: "{{ accepted_plan_sha256 }}"
  conflict_behavior: "block_and_return_to_KAS_for_disposition"

fallback_policy: none_fail_closed
no_gjc_self_approval: true

remediation_prompt_contract:
  canonical_phase_aliases_ref: registries/phase-contracts.yaml#v02flow009_implementer_phase_dispatch_contract
  supported_gjc_lane: "selected GJC `ultragoal` executor lane"
  accepted_scope_ref: required
  ralplan_artifact_ref: required
  ralplan_artifact_sha256: required
  blue_plan_lock_or_implementation_approval_ref: required
  selected_ultragoal_session_ref: required_at_dispatch_time
  selected_ultragoal_goal_ref: required_at_dispatch_time
  finding_bundle:
    finding_id: required
    source_lane: required
    severity_or_blocker_state: required
    blue_disposition: required
    accepted_scope_ref: required
    required_reopened_or_amended_phases: required_when_terminal_phase_touched
    audited_reopen_or_amend_evidence_ref: required_when_terminal_phase_touched
    refreshed_verification: required
    focused_re_review_or_mar_refresh_handoff_ref: required
  fail_closed_on:
    - missing_kah_v02flow010_capability_readback
    - missing_or_stale_ralplan_ref
    - missing_ralplan_hash
    - missing_blue_plan_lock_or_implementation_approval_ref
    - missing_accepted_scope_ref
    - missing_ultragoal_session_or_goal_ref_at_dispatch_time
    - unsafe_or_out_of_run_ref
    - checksum_mismatch_or_unsafe_checksum
    - stale_or_absent_verification
    - native_gjc_ai_slop_cleaner_or_remove_ai_slop_request
    - kab_dispatch_success_as_completion_evidence
    - blue_or_color_source_patch_fallback_without_recorded_exception
  negative_boundaries:
    - "KAB dispatch success is dispatch evidence only, not completion evidence."
    - "Blue/color source-patch fallback is forbidden unless a recorded exception exists."
    - "KAT evidence is mechanical/factual only."
forbidden_scope:
  - unreviewed scope expansion
  - KAB Stage 2/3 activation
  - real async GJC ultragoal invocation except the explicitly approved bounded GAJAE-008 native GJC smoke
  - live KAT invocation unless separately approved
  - provider/auth/token/gateway/model/profile mutation
  - install/release/push
  - GJC self-approval
  - GAJAE-004 async callback pilot
  - GAJAE-006 watcher/callback closeout
  - native GJC `ai-slop-cleaner` or `remove-ai-slop` command requests; route remediation through the selected ultragoal executor phase brief instead

expected_outputs:
  - artifact_kind: candidate_review_fix_evidence
    artifact_refs_required: true
    acceptance_status: candidate_until_reverification_and_review
  - artifact_kind: kat_evidence_attachment
    artifact_refs_required: false
    support_status: deferred_until_KAH_review_fix_status_support
    acceptance_status: not_required_for_review_fix_candidate_evidence

artifact_ref_contract:
  packet_ref: "KAS input packet evidence: path plus sha256, validated by KAH mechanically."
  artifact_refs: "GJC candidate output evidence: run-local paths plus sha256 hashes."
  kat_refs: "Deferred for review_fix_turn until KAH supports review-fix KAT attachment; when supported, KAT factual evidence must include status_ref, summary_ref, summary_md_ref, raw_log_ref, status_hash, raw_log_hash, extractor_status, command_exit_code, attachment_status, and matching run_id."
  hash_rule: "sha256:<64 lowercase hex characters>"
  run_local_only: true

completion_boundary:
  candidate_status: review_fix_candidate_ready
  kat_status: deferred_until_KAH_review_fix_status_support
  not_completion: "Does not close findings, approve MAR, approve color review, approve waiver, or mark final completion."
