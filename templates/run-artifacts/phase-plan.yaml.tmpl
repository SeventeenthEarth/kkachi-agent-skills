run_id: "{{ run_id }}"
task_id: "{{ task_id }}"
project: "{{ project }}"
workflow_authority: run_local_phase_plan
status: draft

authority:
  rule: "phase-plan.yaml is run-local execution state/evidence. .kkachi-workflow.yaml is project-level graph state only after capability-checked KAH graph evidence. KAH work_path/work_mode/execution_mode are helper classification metadata only."
  graph_evidence_artifact: graph-evidence.md
  graph_capability_preflight:
    required_before_project_graph_use: true
    missing_capability_policy: record_gap_and_use_run_local_phase_evidence_only
    forbidden_fallbacks:
      - kah graph alias without evidence
      - direct .kkachi-workflow.yaml edit
  user_selected_task: true
  roadmap_task_id: "{{ roadmap_task_id }}"
  source_docs:
    - path: "{{ source_doc_path }}"
      purpose: "{{ source_doc_purpose }}"

roles:
  hermes:
    responsibility:
      - manager_orchestrator
      - risk_approval_router
      - final_verifier
  planner_backend:
    backend: "{{ planner_backend }}"
    session_id: "{{ planner_session_id }}"
    phases:
      - plan
      - ask
  implementer_backend:
    backend: "{{ implementer_backend }}"
    session_id: "{{ implementer_session_id }}"
    phases:
      - implement
      - enhance_test
      - optimize
      - update_docs
      - handle_feedback
  feedback_backend:
    backend: "{{ feedback_backend }}"
    session_id: "{{ feedback_session_id }}"
    phases:
      - request_feedback

kah_classification:
  work_path: "{{ work_path }}"
  work_mode: "{{ work_mode }}"
  execution_mode: "{{ execution_mode }}"
  urgency: "{{ urgency }}"
  sot_policy: "{{ sot_policy }}"
  note: "Informational helper metadata; it does not override phase applicability below."

kab_usage:
  required: "{{ kab_required }}"
  rationale: "{{ kab_usage_rationale }}"
  no_kab_exception: "{{ no_kab_exception_reason }}"

stage1_direct_codex_runner:
  template_path: "templates/runners/direct-codex-sdk-appserver-runner.py.tmpl"
  sdk_app_server_mode: "openai_codex -> codex app-server --listen stdio://"
  rendered_runner_path: "{{ stage1_direct_codex_rendered_runner_path }}"
  metadata_path: "{{ stage1_direct_codex_metadata_path }}"
  output_path: "{{ stage1_direct_codex_output_path }}"
  thread_id: "{{ stage1_direct_codex_thread_id }}"
  no_kab_codex_rationale: "{{ stage1_direct_codex_no_kab_rationale }}"
  forbidden_as_stage1_evidence:
    - codex exec
    - generic openai Python SDK
    - raw ws/unix/rest app-server transport
    - KAB native_codex session evidence

output_policy:
  language: english_product_and_backend_output
  applies_to:
    - direct_codex_app_server
    - kab_mediated_backend_lanes
  compact_console_schema:
    - "Status: <pass|fail|blocked|in_progress|not_applicable>"
    - "Summary: <1-5 bullets>"
    - "Files: <changed/inspected paths only>"
    - "Verification: <commands/checks and short result>"
    - "Risks/blockers: <only actionable remaining issues>"
    - "Detailed artifact: <path or not_applicable reason>"
    - "Next action requested: <approval/review/none>"
  detailed_artifact_path: ".kkachi/runs/<run_id>/artifacts/<phase>/backend-<phase>.md"
  fail_closed_rule: "If a backend cannot write the detailed artifact, record Status: blocked and the blocker; do not dump long plans, logs, diffs, files, reviews, or checklists into chat."

evidence_summary_policy:
  phase_packet_template: "templates/run-artifacts/phase-packet.yaml.tmpl"
  run_summary_template: "templates/run-artifacts/run-summary.yaml.tmpl"
  phase_packet_path: ".kkachi/runs/<run_id>/phase-packets/<phase>.yaml"
  run_summary_path: ".kkachi/runs/<run_id>/run-summary.yaml"
  retrieval_order:
    - "Read run-summary.yaml first when packet_validity is current."
    - "Read the relevant phase packet before broad source-artifact retrieval."
    - "Retrieve targeted source artifact ranges when checksums mismatch, status is fail/blocked, compression-forbidden evidence is needed, review/final-gate findings are blocking, or packet_validity is stale/invalid/superseded."
  retrieval_style: "read-summary-first"
  reversible_evidence_rule: "Phase packets and run summaries are indexes; full detail remains recoverable by artifact paths and checksums, and evidence must not be discarded to save tokens."
  required_pointer_rule: "Packets and summaries preserve artifact paths, checksums, retrieval instructions, and invalidation behavior before they are used for decisions."
  compression_forbidden_classes:
    - acceptance_criteria
    - approval_or_denial
    - forbidden_scope_or_non_goal
    - auth_token_provider_gateway_model_boundary
    - exact_failing_assertion_or_command_failure
    - blocking_review_finding
    - kah_final_gate_failure
  compression_safe_classes:
    - successful_repetitive_logs
    - dependency_install_build_noise
    - broad_unchanged_inventory
    - repeated_status_readback
    - already_preserved_artifact_body
    - non_critical_progress_chatter
    - large_passing_command_output_with_log_path_checksum
  invalidation_rule: "Invalidate and regenerate the packet/summary when referenced artifacts are missing, referenced checksums change, phase/run status changes, or acceptance criteria, forbidden scope, approval/denial, review finding, or gate verdict changes."
  forbidden_scope:
    - "no evidence discard"
    - "no Hermes proxy, headroom dependency, or runtime context-pruning requirement"
    - "no KAH subjective summarization or compression-policy decision"
    - "no KAB compression-policy decision or backend-selection mutation"
    - "no auth/token/provider/gateway/model mutation authorization"

task_class_gating:
  aliases:
    simple_report: simple_command_report
    investigation: research_evidence
    review: collaboration_review
    docs_only: docs_only
  rule: "Simple report/status, investigation/research evidence, and docs-only paths do not inherit implementation, enhance_test, optimize, or broad review loops unless the task contract records a classification change and reason."

kab_adoption_stage:
  selected_stage: "{{ kab_adoption_stage }}"
  marker_path: "{{ kab_adoption_marker_path }}"
  marker_readback_evidence: "{{ kab_adoption_marker_readback_evidence }}"
  runbook_reference: "skills/kkachi-install-guide/references/kas-kab-adoption-stage-runbook.md"
  evidence_posture: "{{ kab_adoption_stage_evidence_posture }}"

implementation_approval:
  risk_level: "{{ low_or_high }}"
  auto_start_allowed: "{{ auto_start_allowed }}"
  explicit_master_approval_required: "{{ explicit_master_approval_required }}"
  high_risk_triggers:
    - "{{ high_risk_trigger }}"
  master_notice_before_auto_start: "{{ master_notice_summary }}"

feedback_loop:
  min_rounds: 1
  max_rounds: 5
  planned_rounds: "{{ planned_feedback_rounds }}"
  round_decision_reason: "{{ feedback_round_decision_reason }}"

codegraph:
  required: "{{ codegraph_required }}"
  command: "{{ codegraph_command }}"
  status_evidence: "{{ codegraph_status_evidence }}"
  unavailable_or_degraded_reason: "{{ codegraph_unavailable_reason }}"

verification_profile:
  selected_profile_id: "{{ selected_verification_profile_id }}"
  selection_source: "{{ project_sot_or_task_contract_or_approval_ref }}"
  notes: "KAS selects the project verification profile; each selected verification profile/gate records mechanical evidence for KAH validation only."
  not_applicable_note: "When status is not_applicable, preserve selected_profile_id, selected_gate_id, command, timeout, applicability, and not_applicable_reason; leave execution evidence fields empty/null because no command ran."
  gates:
    - selected_gate_id: "aggregate"
      kind: "aggregate"
      command: "{{ aggregate_command_or_not_applicable }}"
      timeout: "{{ aggregate_timeout }}"
      applicability: "{{ required_conditional_optional_or_not_applicable }}"
      not_applicable_reason: "{{ aggregate_not_applicable_reason }}"
      evidence:
        status: "{{ pass_fail_or_not_applicable }}"
        exit_code: "{{ exit_code_or_null_when_command_ran_no_value_when_not_run }}"
        duration: "{{ duration_or_null_when_command_ran_no_value_when_not_run }}"
        log_path: "{{ full_log_artifact_path_or_null_when_command_ran_no_value_when_not_run }}"
        log_checksum: "{{ sha256_or_null_when_command_ran_no_value_when_not_run }}"
        bounded_failure_excerpt: "{{ compact_excerpt_or_empty_when_no_failure_or_not_run }}"
        deterministic_failure_extractor_posture: "{{ extractor_id_and_extracted_not_found_or_empty_when_not_run }}"
    - selected_gate_id: "{{ prepare_unit_integration_e2e_docs_or_task_specific_gate_id }}"
      kind: "{{ prepare_unit_integration_e2e_docs_or_task_specific }}"
      command: "{{ gate_command_or_not_applicable }}"
      timeout: "{{ gate_timeout }}"
      applicability: "{{ required_conditional_optional_or_not_applicable }}"
      not_applicable_reason: "{{ gate_not_applicable_reason }}"
      evidence:
        status: "{{ pass_fail_or_not_applicable }}"
        exit_code: "{{ exit_code_or_null_when_command_ran_no_value_when_not_run }}"
        duration: "{{ duration_or_null_when_command_ran_no_value_when_not_run }}"
        log_path: "{{ full_log_artifact_path_or_null_when_command_ran_no_value_when_not_run }}"
        log_checksum: "{{ sha256_or_null_when_command_ran_no_value_when_not_run }}"
        bounded_failure_excerpt: "{{ compact_excerpt_or_empty_when_no_failure_or_not_run }}"
        deterministic_failure_extractor_posture: "{{ extractor_id_and_extracted_not_found_or_empty_when_not_run }}"
  token_002_hooks:
    - "compact schema present in docs/sot, registries, templates, and skills"
    - "artifact-first/fail-closed policy present"
    - "task-class gating and aliases present"
    - "Korean product-output check scoped to backend prompts, run artifacts, and relevant registries"
    - "forbidden broad long-output dumping wording search"

change_verification_matrix:
  template: "templates/run-artifacts/change-verification-matrix.yaml.tmpl"
  artifact_path: ".kkachi/runs/<run_id>/change-verification-matrix.yaml"
  contract_version: "token010.v1"
  required_when: "Changed-path classification affects selected/scoped/skipped verification or final aggregate preservation."
  policy_owner: "KAS"
  kah_validation_role: "mechanical_recorded_evidence_only"
  required_fields:
    - selected_rule_id
    - changed_paths
    - changed_path_set_classes
    - selected_verification_commands
    - scoped_verification
    - skipped_gates
    - skip_reason
    - no_skipped_gates_reason_when_skipped_gates_is_empty
    - deterministic_evidence_refs_with_checksums
    - final_aggregate_preservation.status
  final_aggregate_rule: "Development tasks preserve final aggregate verification unless task contract or responsible approval explicitly marks it not_applicable with deterministic evidence."
  boundary_rule: "KAH validates recorded deterministic evidence only; KAH must not decide skip policy or choose tests to skip."

phases:
  - phase: plan
    applicability: required
    state: pending
    owner_role: planner_backend
    backend_or_session: "{{ planner_session_id }}"
    evidence:
      - plan.md
      - checklist.md
      - acceptance-criteria.md
      - codegraph_status_evidence_when_required
      - backend-plan-artifact-when_backend_used
    check: "kkachi-agent-helper gate check {{ run_id }} plan --json"
    skip_reason: ""
  - phase: ask
    applicability: required
    state: pending
    owner_role: planner_backend_plus_hermes
    backend_or_session: "{{ planner_session_id }}"
    evidence:
      - ask.md
      - answered-decisions.md
    check: "No unresolved decision blocker before implement."
    skip_reason: ""
  - phase: implement
    applicability: "{{ implement_applicability }}"
    state: pending
    owner_role: implementer_backend
    backend_or_session: "{{ implementer_session_id }}"
    evidence:
      - diff.patch
      - impl-log.md
      - cli-output.md
      - make-test-after-implementation
      - ".kkachi/runs/<run_id>/artifacts/implement/backend-implement.md"
    check: "Implementation matches approved plan and acceptance criteria; aggregate verification passes after implementation changes."
    skip_reason: "{{ implement_skip_reason }}"
  - phase: enhance_test
    applicability: conditional
    state: pending
    owner_role: implementer_backend
    backend_or_session: "{{ implementer_session_id }}"
    evidence:
      - test-plan.md
      - test-log.md
      - make-test-after-test-enhancement
    check: "Unit, integration, and e2e coverage considered; focused regression coverage added or no-change reason recorded; aggregate verification passes after changes."
    skip_reason: "{{ enhance_test_skip_reason }}"
  - phase: optimize
    applicability: conditional_recommended_for_code_change
    state: pending
    owner_role: implementer_backend
    backend_or_session: "{{ implementer_session_id }}"
    evidence:
      - slop-cleanup-log.md
      - optimize-log.md
      - make-test-after-slop-cleanup
      - make-test-after-optimization
      - verification_after_cleanup
    check: "AI slop, duplication, unnecessary abstraction, and algorithmic/structural waste considered; aggregate verification passes after cleanup/optimization changes."
    skip_reason: "{{ optimize_skip_reason }}"
  - phase: update_docs
    applicability: conditional
    state: pending
    owner_role: implementer_backend
    backend_or_session: "{{ implementer_session_id }}"
    evidence:
      - docs-update.md
      - roadmap-update.md
    check: "Docs and roadmap updated or no-change reason recorded; completion status matches evidence."
    skip_reason: "{{ update_docs_skip_reason }}"
  - phase: request_feedback_1
    applicability: required
    state: pending
    owner_role: feedback_backend
    backend_or_session: "{{ feedback_session_id }}"
    evidence:
      - feedback-request.md
      - feedback-1.md
    check: "Independent feedback requested and captured."
    skip_reason: ""
  - phase: handle_feedback_1
    applicability: required
    state: pending
    owner_role: implementer_backend_plus_hermes
    backend_or_session: "{{ implementer_session_id }}"
    evidence:
      - feedback-triage-1.md
      - handle-feedback-1.md
    check: "Valid feedback handled; no actionable feedback recorded when applicable."
    skip_reason: ""
  - phase: request_feedback_2
    applicability: conditional
    state: skipped
    owner_role: feedback_backend
    backend_or_session: "{{ feedback_session_id }}"
    evidence:
      - feedback-2.md
    check: "Run only if Hermes requests a second feedback round."
    skip_reason: "{{ feedback_2_skip_reason }}"
  - phase: handle_feedback_2
    applicability: conditional
    state: skipped
    owner_role: implementer_backend_plus_hermes
    backend_or_session: "{{ implementer_session_id }}"
    evidence:
      - feedback-triage-2.md
      - handle-feedback-2.md
    check: "Required only if request_feedback_2 runs."
    skip_reason: "{{ feedback_2_skip_reason }}"
  - phase: request_feedback_3
    applicability: conditional
    state: skipped
    owner_role: feedback_backend
    backend_or_session: "{{ feedback_session_id }}"
    evidence:
      - feedback-3.md
    check: "Run only if Hermes requests a third feedback round."
    skip_reason: "{{ feedback_3_skip_reason }}"
  - phase: handle_feedback_3
    applicability: conditional
    state: skipped
    owner_role: implementer_backend_plus_hermes
    backend_or_session: "{{ implementer_session_id }}"
    evidence:
      - feedback-triage-3.md
      - handle-feedback-3.md
    check: "Required only if request_feedback_3 runs."
    skip_reason: "{{ feedback_3_skip_reason }}"
  - phase: request_feedback_4
    applicability: conditional
    state: skipped
    owner_role: feedback_backend
    backend_or_session: "{{ feedback_session_id }}"
    evidence:
      - feedback-4.md
    check: "Run only if Hermes requests a fourth feedback round."
    skip_reason: "{{ feedback_4_skip_reason }}"
  - phase: handle_feedback_4
    applicability: conditional
    state: skipped
    owner_role: implementer_backend_plus_hermes
    backend_or_session: "{{ implementer_session_id }}"
    evidence:
      - feedback-triage-4.md
      - handle-feedback-4.md
    check: "Required only if request_feedback_4 runs."
    skip_reason: "{{ feedback_4_skip_reason }}"
  - phase: request_feedback_5
    applicability: conditional
    state: skipped
    owner_role: feedback_backend
    backend_or_session: "{{ feedback_session_id }}"
    evidence:
      - feedback-5.md
    check: "Maximum feedback round; run only if Hermes requests a fifth feedback round."
    skip_reason: "{{ feedback_5_skip_reason }}"
  - phase: handle_feedback_5
    applicability: conditional
    state: skipped
    owner_role: implementer_backend_plus_hermes
    backend_or_session: "{{ implementer_session_id }}"
    evidence:
      - feedback-triage-5.md
      - handle-feedback-5.md
    check: "Required only if request_feedback_5 runs."
    skip_reason: "{{ feedback_5_skip_reason }}"
  - phase: final_verify
    applicability: required
    state: pending
    owner_role: hermes
    backend_or_session: local
    evidence:
      - verification.md
      - final-report.md
      - checklist.md
      - run-summary.yaml
      - phase-packets/<phase>.yaml
    check: "kkachi-agent-helper gate final {{ run_id }} --json"
    skip_reason: ""
  - phase: improve
    applicability: conditional
    state: pending
    owner_role: hermes
    backend_or_session: local
    evidence:
      - improvement-note.md
    check: "Reusable lesson recorded or no-promotion decision noted."
    skip_reason: "{{ improve_skip_reason }}"
