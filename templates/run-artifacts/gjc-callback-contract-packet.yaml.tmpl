schema_version: kas.gajae_gjc_packet.v1
packet_kind: callback_contract
task_id: "{{ task_id }}"
run_id: "{{ run_id }}"

source_command:
  korean: "{{ korean_source_command }}"
  role: "source-of-truth command text; do not translate or replace it."

gjc_operational_brief_english: |
  Prepare productized callback/watcher metadata for a ready candidate artifact
  without claiming same-thread wake, plan approval, review acceptance, MAR
  acceptance, or final completion. GAJAE-004 callback delivery and GAJAE-006
  watcher closeout are factual evidence only until KAS/Blue/color/MAR/final
  gates accept them. If notification origin/thread plus watcher evidence is
  unavailable, record no-wake-claim.

authority_boundaries:
  owner: KAS/Blue/color/MAR/final
  rule: "Callbacks may report candidate readiness only; KAS/Blue/color/MAR/final gates decide acceptance."
  kah_role: "KAH validates packet_ref and artifact_refs mechanically only."
  no_acceptance_by_gjc: true

stop_ask_gates:
  ask_required_when:
    - "notification target or origin metadata is missing for a claimed wake path"
    - "callback would imply approval, review acceptance, MAR acceptance, or final completion"
  stop_required_when:
    - "packet_ref is missing, stale, or checksum-mismatched"
    - "idempotency metadata is missing"
    - "same-thread wake is asserted without watcher evidence"

plan_lock:
  required_before_implementation: "{{ true_when_callback_reports_implementation_ready }}"
  accepted_plan_hash: "{{ accepted_plan_sha256_or_not_applicable }}"
  conflict_behavior: "block_and_return_to_KAS"

fallback_policy: none_fail_closed
no_gjc_self_approval: true

forbidden_scope:
  - same-thread Discord wake claims without metadata and watcher evidence
  - callback approval of plan/review/MAR/final gates
  - KAB Stage 2/3 activation
  - provider/auth/token/gateway/model/profile mutation
  - install/release/push
  - GAJAE-005 KAT/ultragoal evidence as approval authority
  - GAJAE-006 watcher/callback closeout as final completion or wake readiness without evidence

expected_outputs:
  - artifact_kind: callback_contract_candidate
    artifact_refs_required: true
    acceptance_status: evidence_only_until_KAS_plan_review

artifact_ref_contract:
  packet_ref: "KAS input packet evidence: path plus sha256, validated by KAH mechanically."
  artifact_refs: "GJC candidate output evidence: run-local paths plus sha256 hashes."
  hash_rule: "sha256:<64 lowercase hex characters>"
  run_local_only: true
  source_status_hash: "Required status_hash that triggered the callback or watcher closeout."
  idempotency_key: "Required replay/conflict key; exact replay is stable, conflicts fail closed."
  callback_result: "pending, delivered, or failed as factual callback evidence only."
  notification_ref: "Use no-wake-claim when same-thread/origin metadata is absent."
  notification_status: "metadata_recorded_no_wake_claim or no_wake_claim; never acceptance."
  wake_evidence_status: "missing_watcher_evidence until explicit origin/thread metadata and watcher proof exist."

completion_boundary:
  candidate_status: callback_delivered
  watcher_status: watcher_closeout_evidence_only
  not_completion: "Does not approve plan, review, MAR, final completion, or same-thread wake readiness."
  same_thread_wake_default: no-wake-claim
