schema_version: kas.gajae_gjc_packet.v1
packet_kind: ultragoal
task_id: "{{ task_id }}"
run_id: "{{ run_id }}"

source_command:
  korean: "{{ korean_source_command }}"
  role: "source-of-truth command text; do not translate or replace it."

gjc_operational_brief_english: |
  Run GJC ultragoal create-goals for the accepted locked plan only. Produce a
  candidate implementation-goal bundle and preserve run-local artifact_refs for
  brief, goals, ledger, and implementation evidence as applicable. If KAT
  fixture evidence is attached by KAH, preserve KAT status, summary, raw-log
  refs, hashes, extractor status, command exit code, and run-id linkage as
  factual evidence only.

authority_boundaries:
  owner: KAS/Blue/color/MAR/final
  rule: "GJC implementation output remains candidate evidence until verification, color review, MAR when required, and final gates pass."
  kah_role: "KAH validates packet_ref and artifact_refs mechanically only."
  no_acceptance_by_gjc: true

stop_ask_gates:
  ask_required_when:
    - "accepted plan hash is missing or conflicts with packet content"
    - "implementation would exceed accepted plan scope"
    - "fix requires a policy, provider, profile, auth, token, gateway, or model decision"
  stop_required_when:
    - "packet_ref is missing, stale, or checksum-mismatched"
    - "plan_lock is not accepted"
    - "candidate output cannot preserve artifact_refs"

plan_lock:
  required_before_implementation: true
  accepted_plan_hash: "{{ accepted_plan_sha256 }}"
  conflict_behavior: "block_and_emit_plan_conflict_report"

fallback_policy: none_fail_closed
no_gjc_self_approval: true

native_ultragoal_input:
  mode: brief_file
  brief: |
    {{ gjc_ultragoal_brief }}
  projection_rule: "KAH must materialize this brief as run-local native_input_ref evidence and invoke GJC 0.7.3 as `ultragoal create-goals --brief-file <native_input_ref.path> --json`; KAH must not pass the packet path as `--packet`."

executor_loop_contract:
  loop_sequence:
    - create-goals
    - complete-goals
    - execute-goal
    - checkpoint
    - verify
    - repeat-or-terminate
  complete_goals_boundary: "Freezes the selected goal bundle only; not implementation completion, implementation acceptance, verification, MAR, second-color, final, or commit readiness."
  accepted_forbidden_in_pre_final_statuses:
    - goal_bundle.status
    - goal_bundle.goals[].status
    - executor_candidate.candidate_status
  top_level_accepted_rule: derived_read_only_post_final_gate_alias_only
  blue_direct_patch_exception_record:
    reason: required
    scope: required
    why_executor_loop_was_not_used: required
    changed_surface_refs: required
    verification_required: true
    review_required: true
    mar_required: true
    final_gate_required: true
    waiver_ref: required

phase_brief_contract:
  canonical_phase_aliases_ref: registries/phase-contracts.yaml#v02flow009_implementer_phase_dispatch_contract
  phase_id_required: true
  supported_gjc_lane: "selected GJC `ultragoal` executor lane"
  required_fields:
    task_id: required
    run_id: required
    approved_scope: required
    approved_scope_ref: required
    accepted_scope_ref: required
    ralplan_artifact_ref: required
    ralplan_artifact_sha256: required
    blue_plan_lock_or_implementation_approval_ref: required
    selected_ultragoal_session_ref: required_at_dispatch_time
    selected_ultragoal_goal_ref: required_at_dispatch_time
    changed_surface_bounds: required
    preservation_locks: required
    non_goals: required
    expected_evidence: required
    verification_commands: required
    stop_block_conditions: required
  fail_closed_on:
    - unknown_phase_id_or_alias
    - ambiguous_alias
    - unsupported_dispatch_shape
    - missing_kah_v02flow010_capability_readback
    - missing_or_stale_ralplan_ref
    - missing_ralplan_hash
    - missing_blue_plan_lock_or_implementation_approval_ref
    - missing_accepted_scope_ref
    - missing_ultragoal_session_or_goal_ref_at_dispatch_time
    - unsafe_or_out_of_run_ref
    - checksum_mismatch_or_unsafe_checksum
    - stale_or_absent_verification
    - native_gjc_ai_slop_cleaner_or_remove_ai_slop_request
    - kab_dispatch_success_as_completion_evidence
    - blue_or_color_source_patch_fallback_without_recorded_exception
  negative_boundaries:
    - "KAB dispatch success is dispatch evidence only, not completion evidence."
    - "Blue/color source-patch fallback is forbidden unless a recorded exception exists."
    - "KAT evidence is mechanical/factual only."

ai_slop_cleaner_phase_contract:
  behavior_lock: required
  cleanup_plan: required_before_editing
  slop_classification: required_before_editing
  deletion_first: true
  one_smell_at_a_time: true
  verification: required_after_each_changed_surface
  closeout_evidence:
    - slop-cleanup-log.md
    - changed_files
    - simplifications
    - behavior_lock_refs
    - verification_refs
    - remaining_risks
  smell_classes:
    - duplicate_logic
    - dead_code
    - needless_wrappers_or_abstractions
    - boundary_leaks
    - weak_regression_coverage
    - over_explaining_comments
    - speculative_branches
    - ungrounded_generated_prose
    - ui_design_defaults_when_task_has_ui_surface
forbidden_scope:
  - KAB Stage 2/3 activation
  - real async GJC ultragoal invocation except the explicitly approved bounded GAJAE-008 native GJC smoke
  - live KAT invocation unless separately approved
  - provider/auth/token/gateway/model/profile mutation
  - install/release/push
  - GJC self-approval
  - warning-only verification gates
  - GAJAE-004 async callback pilot
  - GAJAE-006 watcher/callback closeout
  - native GJC `ai-slop-cleaner` or `remove-ai-slop` command requests; use the KAS phase brief through ultragoal executor lane instead

expected_outputs:
  - artifact_kind: candidate_ultragoal_bundle
    artifact_refs_required: true
    acceptance_status: candidate_until_verification_review_mar_final
  - artifact_kind: kat_evidence_attachment
    artifact_refs_required: true
    acceptance_status: factual_until_KAS_Blue_color_MAR_final_review

artifact_ref_contract:
  packet_ref: "KAS input packet evidence: path plus sha256, validated by KAH mechanically."
  artifact_refs: "GJC candidate output evidence: run-local paths plus sha256 hashes."
  kat_refs: "KAT factual evidence: status_ref, summary_ref, summary_md_ref, raw_log_ref, status_hash, raw_log_hash, extractor_status, command_exit_code, attachment_status, and matching run_id."
  hash_rule: "sha256:<64 lowercase hex characters>"
  run_local_only: true

completion_boundary:
  candidate_status: implementation_goal_bundle_ready
  technical_aliases:
    - ultragoal_goals_ready
    - gjc_goal_bundle_ready
  legacy_status: ultragoal_ready
  legacy_status_boundary: "Compatibility/readback alias only; not source mutation, implementation diff readiness, verification, review, MAR, waiver, or final acceptance."
  kat_status: kat_evidence_ready
  reserved_after_executor_loop:
    - implementation_diff_ready
    - implementation_candidate_ready
    - implementation_verified
  not_completion: "Does not approve implementation, tests, review findings, MAR, color review, waiver, or final completion."
