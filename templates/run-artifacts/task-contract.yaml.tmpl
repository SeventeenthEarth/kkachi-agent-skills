run_id: "{{ run_id }}"
task_id: "{{ task_id }}"
project: "{{ project }}"
work_path: "{{ work_path }}"
work_mode: "{{ work_mode }}"
phase: "{{ phase }}"
execution_mode: "{{ execution_mode }}"

activation_scope:
  mode: "{{ activation_mode }}" # direct_commander_response | khs_project_execution
  trigger: "{{ khs_activation_trigger }}"
  project_directory_scope: "{{ project_directory_scope }}"
  non_khs_reason: "{{ non_khs_reason }}"

task_classification:
  task_class: "{{ task_class }}"
  task_type: "{{ task_type }}"
  classification_reason: "{{ task_classification_reason }}"
  selected_spine: "{{ selected_spine }}"
  kab_default: "{{ kab_default }}"
  kah_required: "{{ kah_required }}"
  codegraph_required: "{{ codegraph_required }}"
  skipped_phase_reasons:
    implement: "{{ implement_skip_reason }}"
    enhance_test: "{{ enhance_test_skip_reason }}"
    optimize: "{{ optimize_skip_reason }}"

teal_applicability:
  contract_version: "design002.v1"
  project_has_teal_lane: {{ project_has_teal_lane }}
  ui_ux_change: {{ ui_ux_change }}
  teal_required: {{ derived_teal_required }}
  derivation: "project_has_teal_lane && ui_ux_change"
  teal_skip_reason: "{{ teal_skip_reason }}"
  teal_waiver_approved: {{ teal_waiver_approved }}
  teal_waiver_approval_ref: "{{ teal_waiver_approval_ref }}"
  teal_waiver_scope: "{{ teal_waiver_scope }}"
  teal_waiver_expires_at: "{{ teal_waiver_expires_at }}"
  kkachi_source_default_skip_reason: "No UI/UX surface in this project/task."
  required_when_teal_required:
    - DESIGN_PLAN_GATE
    - DESIGN_FIDELITY_REVIEW
  missing_required_status: "required_teal_verdict_missing"
  no_substitution_rule: "Ordinary Red/Orange/Gray/Blue color review, MAR, backend evidence, and temporary helpers are not substitutes for required Teal verdicts."

workflow_authority:
  project_graph_artifact: ".kkachi-workflow.yaml"
  run_local_phase_artifact: "phase-plan.yaml"
  graph_evidence_artifact: "graph-evidence.md"
  rule: ".kkachi-workflow.yaml is project-level graph state only after capability-checked KAH graph evidence; phase-plan.yaml is run-local execution state/evidence; KAH metadata is helper classification only."
  graph_capability_preflight_required: "{{ graph_capability_preflight_required }}"
  missing_graph_capability_policy: "record_gap_and_use_run_local_phase_evidence_only"
  graph_evidence_preservation:
    required_when_graph_affects_run: true
    artifact: "graph-evidence.md"
    report_section: "kah_graph_evidence"
    fields:
      - template_id
      - template_path
      - template_version
      - proposal_id
      - proposal_path
      - semantic_diff_output_path
      - validation_report_path
      - explain_report_path
      - approval_evidence_ref
      - audit_evidence_path
      - graph_checksum
      - graph_version
      - kah_graph_audit_event_ids
      - capability_check_evidence

selected_task:
  user_selected: true
  roadmap_task_id: "{{ roadmap_task_id }}"
  task_source: "{{ task_source }}"
  auto_selected_by_khs: false

desired_state: |
  {{ desired_state }}

acceptance_criteria:
  - "{{ acceptance_criterion }}"

constraints:
  - "{{ constraint }}"

non_goals:
  - "{{ non_goal }}"

context_sources:
  - path: "{{ context_path }}"
    purpose: "{{ context_purpose }}"

required_capabilities:
  write: "{{ required_write }}"
  approval_control: "{{ required_approval_control }}"
  question_flow: "{{ required_question_flow }}"
  retained_events: "{{ required_retained_events }}"
  observability: "{{ required_observability }}"
  restart_recovery: "{{ restart_recovery_sensitivity }}"
  graph_workflow: "{{ required_graph_workflow }}"
  graph_commands:
    - "kkachi-agent-helper graph --help"
    - "kkachi-agent-helper graph validate --file .kkachi-workflow.yaml --json"
    - "kkachi-agent-helper graph explain --file .kkachi-workflow.yaml --json"

user_backend_preference:
  provided: "{{ user_backend_preference_provided }}"
  value: "{{ user_backend_preference }}"
  rule: "Apply only after capability and project-policy gates pass."

verification:
  commands:
    - "{{ verification_command }}"
  evidence_required:
    - "{{ evidence_required }}"

khs_operating_policy:
  classify_only_after_khs_activation: true
  default_mode_is_direct_commander_response: true
  classify_before_phase_selection: true
  development_full_spine_only_for_development_tasks: true
  research_docs_simple_tasks_use_light_spines: true
  kab_required_for_code_change: true
  docs_only_uses_kab_by_default: false
  docs_only_uses_kab_when_backend_execution_or_review_transport_is_required: true
  no_kab_code_change_means_direct_hermes_not_khs: true
  ask_phase_required: false
  approval_boundary_required_when_policy_or_question_requires: true
  feedback_rounds:
    min: 1
    max: 5
  optimize_for_code_change: conditional_recommended
