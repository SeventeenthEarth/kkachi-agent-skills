#!/usr/bin/env python3
KIND = "{{KIND}}"
import os
import re
import subprocess
import json
import sys
from pathlib import Path

TOOLCHAIN_SCHEMA_V1 = "kkachi.toolchain.v1"
TOOL_NAMES = {"kas": "kkachi-agent-skills-toolchain", "kah": "kkachi-agent-helper-toolchain", "kat": "kkachi-agent-tester-toolchain"}
BIN_NAMES = {"kas": "kkachi-agent-skills", "kah": "kkachi-agent-helper", "kat": "kkachi-agent-tester"}
SEMVER_RE = re.compile(r"^v?(\d+\.\d+\.\d+)$")
SEMVER_TOKEN_RE = re.compile(r"(?<![A-Za-z0-9._-])v?(\d+\.\d+\.\d+)(?![A-Za-z0-9._-])")
KEY_RE = re.compile(r"^[A-Za-z0-9_-]+$")
REQUIRED_MAR_CAPABILITY_VERSION = "mar.validation-only.v1"
REQUIRED_MAR_SUBCOMMANDS = {"start", "status", "validate", "wait", "cancel"}


def fail(message: str) -> None:
    print(f"{TOOL_NAMES[KIND]}: {message}", file=sys.stderr)
    raise SystemExit(1)


def strip_yaml_comment(value: str) -> str:
    quote = ""
    escaped = False
    out = []
    for ch in value:
        if escaped:
            out.append(ch)
            escaped = False
            continue
        if ch == "\\" and quote:
            out.append(ch)
            escaped = True
            continue
        if ch in ("'", '"'):
            if not quote:
                quote = ch
            elif quote == ch:
                quote = ""
            out.append(ch)
            continue
        if ch == "#" and not quote:
            break
        out.append(ch)
    if quote:
        raise ValueError("unterminated quoted scalar")
    return "".join(out).strip()


def unquote(value: str) -> str:
    value = value.strip()
    if not value:
        return value
    if value[0] in ("'", '"'):
        if len(value) < 2 or value[-1] != value[0]:
            raise ValueError("unterminated quoted scalar")
        return value[1:-1]
    if value[-1:] in ("'", '"'):
        raise ValueError("unterminated quoted scalar")
    return value


def parse_toolchain(path: Path) -> dict:
    try:
        text = path.read_text(encoding="utf-8")
    except Exception as exc:
        fail(f"cannot read {path}: {exc}")
    values = {}
    stack = []
    for line_no, raw_line in enumerate(text.splitlines(), start=1):
        if "\t" in raw_line:
            fail(f"malformed {path}: tab indentation is not supported at line {line_no}")
        stripped = raw_line.strip()
        if not stripped or stripped == "---" or stripped.startswith("#"):
            continue
        if stripped.startswith("-"):
            continue
        indent = len(raw_line) - len(raw_line.lstrip(" "))
        if indent % 2 != 0:
            fail(f"malformed {path}: indentation must use two-space levels at line {line_no}")
        level = indent // 2
        if level > len(stack):
            fail(f"malformed {path}: unexpected indentation at line {line_no}")
        if ":" not in stripped:
            fail(f"malformed {path}: expected key: value at line {line_no}")
        key, raw_value = stripped.split(":", 1)
        key = key.strip()
        if not KEY_RE.match(key):
            fail(f"malformed {path}: unsupported key {key!r} at line {line_no}")
        stack = stack[:level]
        try:
            value = unquote(strip_yaml_comment(raw_value))
        except ValueError as exc:
            fail(f"malformed {path}: {exc} at line {line_no}")
        dotted = ".".join(stack + [key])
        if value == "":
            stack.append(key)
            continue
        if dotted in values:
            fail(f"malformed {path}: duplicate key {dotted} at line {line_no}")
        values[dotted] = value
        if level == 0:
            values[key] = value
    if not values:
        fail(f"malformed {path}: no scalar metadata found")
    return values


def find_project_root() -> Path:
    start_raw = os.environ.get("KKACHI_PROJECT_ROOT") or os.getcwd()
    try:
        current = Path(start_raw).expanduser().resolve()
    except Exception as exc:
        fail(f"cannot resolve project root from {start_raw}: {exc}")
    if current.is_file():
        current = current.parent
    while True:
        candidate = current / ".kkachi" / "toolchain.yaml"
        if candidate.is_file():
            return current
        if current.parent == current:
            fail("missing .kkachi/toolchain.yaml; run from a configured Kkachi project or set KKACHI_PROJECT_ROOT")
        current = current.parent


def normalize_version(raw: str, field: str) -> str:
    value = (raw or "").strip()
    match = SEMVER_RE.match(value)
    if not match:
        fail(f"invalid {field} value {value!r} in .kkachi/toolchain.yaml; expected vX.Y.Z or X.Y.Z")
    return "v" + match.group(1)


def default_toolchain_root() -> Path:
    override = os.environ.get("KKACHI_TOOLCHAIN_ROOT")
    if override:
        return Path(override).expanduser()
    candidates = [Path.home() / ".local" / "kkachi" / "toolchains"]
    user = os.environ.get("USER") or os.environ.get("LOGNAME")
    if user:
        candidates.extend([
            Path("/Users") / user / ".local" / "kkachi" / "toolchains",
            Path("/home") / user / ".local" / "kkachi" / "toolchains",
        ])
    for candidate in candidates:
        if candidate.exists():
            return candidate
    return candidates[0]


def select_toolchain(config: Path) -> dict:
    values = parse_toolchain(config)
    toolchain_root = default_toolchain_root()
    schema = values.get("schema_version", "").strip()
    if schema != TOOLCHAIN_SCHEMA_V1:
        fail(f"missing or unsupported schema_version {schema!r} in {config}; expected {TOOLCHAIN_SCHEMA_V1}")
    for field in ("kas.cli_version", "kah.cli_version", "kah.binary_path", "kat.cli_version", "kat.binary_path"):
        if not values.get(field, "").strip():
            fail(f"missing required {field} in {config}")
    kas_version = normalize_version(values["kas.cli_version"], "kas.cli_version")
    kah_version = normalize_version(values["kah.cli_version"], "kah.cli_version")
    kat_version = normalize_version(values["kat.cli_version"], "kat.cli_version")
    kah_bin = Path(values["kah.binary_path"].strip()).expanduser()
    kat_bin = Path(values["kat.binary_path"].strip()).expanduser()
    if not kah_bin.is_absolute():
        fail(f"kah.binary_path must be absolute in {config}")
    if not kat_bin.is_absolute():
        fail(f"kat.binary_path must be absolute in {config}")
    return {
        "schema_version": schema,
        "config": str(config),
        "toolchain_root": str(toolchain_root),
        "kas_cli_version": kas_version,
        "kah_cli_version": kah_version,
        "kat_cli_version": kat_version,
        "kas_bin": str(toolchain_root / "kas" / kas_version / "bin" / BIN_NAMES["kas"]),
        "kah_bin": str(kah_bin),
        "kat_bin": str(kat_bin),
    }


def require_executable(path_value: str, label: str) -> Path:
    path = Path(path_value)
    if not path.is_file() or not os.access(path, os.X_OK):
        fail(f"selected {label} binary is not executable: {path}")
    return path


def version_output(binary: Path) -> str:
    try:
        completed = subprocess.run([str(binary), "--version"], check=False, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=15)
    except Exception as exc:
        fail(f"version check failed for {binary}: {exc}")
    output = (completed.stdout or "").strip()
    if completed.returncode != 0:
        fail(f"version check failed for {binary}: exit {completed.returncode}: {output}")
    return output


def assert_version(binary: Path, expected: str, label: str) -> str:
    output = version_output(binary)
    match = SEMVER_TOKEN_RE.search(output)
    if not match:
        fail(f"{label} version output did not contain a semver token: {output!r}")
    actual = "v" + match.group(1)
    if actual != expected:
        fail(f"{label} binary version mismatch: metadata expects {expected}, {binary} reports {actual} ({output})")
    return output


def assert_kah_mar_capability(kah_bin: Path) -> None:
    try:
        completed = subprocess.run([str(kah_bin), "capabilities", "--json"], check=False, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=15)
    except Exception as exc:
        fail(f"KAH MAR capability check failed for {kah_bin}: {exc}")
    if completed.returncode != 0:
        detail = (completed.stderr or completed.stdout or "").strip()
        fail(f"KAH MAR capability check failed for {kah_bin}: exit {completed.returncode}: {detail}")
    try:
        payload = json.loads(completed.stdout or "{}")
    except json.JSONDecodeError as exc:
        fail(f"KAH MAR capability check returned invalid JSON: {exc}")
    mar_group = None
    for group in payload.get("command_groups") or []:
        if isinstance(group, dict) and group.get("name") == "mar":
            mar_group = group
            break
    if not mar_group or mar_group.get("status") != "supported":
        fail("KAH binary missing supported mar command group; effective helper must expose NEWMAR-003 MAR capability")
    subcommands = set(mar_group.get("subcommands") or [])
    missing = sorted(REQUIRED_MAR_SUBCOMMANDS - subcommands)
    if missing:
        fail(f"KAH MAR command group missing required subcommands: {', '.join(missing)}")
    flags = payload.get("compatibility_flags") or {}
    for flag in ("mar_command_group", "mar_request_validation", "mar_no_provider_blocked_receipt", "mar_wait_timeout", "mar_cancel_safety", "kat_toolchain_probe", "kat_toolchain_evidence_binding"):
        if flags.get(flag) is not True:
            fail(f"KAH missing required compatibility flag: {flag}")
    actual = flags.get("mar_capability_version")
    if actual != REQUIRED_MAR_CAPABILITY_VERSION:
        fail(f"KAH MAR capability version mismatch: expected {REQUIRED_MAR_CAPABILITY_VERSION}, got {actual!r}")


def resolve(project_root: Path) -> dict:
    config = project_root / ".kkachi" / "toolchain.yaml"
    meta = select_toolchain(config)
    meta["project_root"] = str(project_root)
    kas_bin = require_executable(meta["kas_bin"], "KAS")
    kah_bin = require_executable(meta["kah_bin"], "KAH")
    kat_bin = require_executable(meta["kat_bin"], "KAT")
    meta["kas_version_output"] = assert_version(kas_bin, meta["kas_cli_version"], "KAS")
    meta["kah_version_output"] = assert_version(kah_bin, meta["kah_cli_version"], "KAH")
    meta["kat_version_output"] = assert_version(kat_bin, meta["kat_cli_version"], "KAT")
    assert_kah_mar_capability(kah_bin)
    return meta


def print_status(meta: dict) -> None:
    for key in ("project_root", "config", "schema_version", "toolchain_root", "kas_cli_version", "kah_cli_version", "kat_cli_version", "kas_bin", "kah_bin", "kat_bin"):
        print(f"{key}={meta[key]}")
    print(f"kas_version_output={meta['kas_version_output']}")
    print(f"kah_version_output={meta['kah_version_output']}")
    print(f"kat_version_output={meta['kat_version_output']}")


def main(argv: list) -> int:
    project_root = find_project_root()
    meta = resolve(project_root)
    if argv and argv[0] == "--toolchain-status":
        print_status(meta)
        return 0
    env = os.environ.copy()
    env["KKACHI_PROJECT_ROOT"] = str(project_root)
    env["KKACHI_EFFECTIVE_KAS_BIN"] = meta["kas_bin"]
    env["KKACHI_EFFECTIVE_KAH_BIN"] = meta["kah_bin"]
    env["KKACHI_EFFECTIVE_KAT_BIN"] = meta["kat_bin"]
    env["KKACHI_KAH_BIN"] = meta["kah_bin"]
    env["KKACHI_KAT_BIN"] = meta["kat_bin"]
    kah_dir = str(Path(meta["kah_bin"]).parent)
    kat_dir = str(Path(meta["kat_bin"]).parent)
    env["PATH"] = kah_dir + os.pathsep + kat_dir + os.pathsep + env.get("PATH", "")
    if KIND == "kas":
        os.execvpe(meta["kas_bin"], [meta["kas_bin"], *argv], env)
    if KIND == "kah":
        os.execvpe(meta["kah_bin"], [meta["kah_bin"], *argv], env)
    os.execvpe(meta["kat_bin"], [meta["kat_bin"], *argv], env)
    return 127


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
