{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kas.mar.provider_registry_correlation.v1",
  "schema_version": "kas.mar.provider_registry_correlation.v1",
  "title": "KAS MAR provider registry and correlation contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lane_identity",
    "provider_identity",
    "adapter_type",
    "provider_registry_ref",
    "provider_registry_schema_version",
    "adapter_proof_ref",
    "provenance_ref",
    "author_backend_correlation",
    "provider_preflight_ref",
    "retry_waiver_approval_ref",
    "mar_start_approval_binding",
    "policy_refs",
    "independence_policy",
    "execution_safety"
  ],
  "properties": {
    "schema_version": {
      "const": "kas.mar.provider_registry_correlation.v1"
    },
    "lane_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "role_id",
        "lane_kind"
      ],
      "properties": {
        "lane_id": {
          "type": "string"
        },
        "role_id": {
          "type": "string"
        },
        "lane_kind": {
          "type": "string"
        }
      }
    },
    "provider_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "provider_family"
      ],
      "properties": {
        "provider_id": {
          "type": "string"
        },
        "provider_family": {
          "type": "string"
        }
      }
    },
    "adapter_type": {
      "enum": [
        "kah_mar",
        "fixture_only"
      ]
    },
    "provider_registry_ref": {
      "$ref": "#/$defs/ref"
    },
    "provider_registry_schema_version": {
      "const": "mar.role_lanes.v1"
    },
    "adapter_proof_ref": {
      "$ref": "#/$defs/ref"
    },
    "provenance_ref": {
      "$ref": "#/$defs/ref"
    },
    "author_backend_correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_family",
        "backend_identity",
        "correlation_id",
        "source_candidate_status",
        "source_packet_sha256"
      ],
      "properties": {
        "backend_family": {
          "type": "string"
        },
        "backend_identity": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string"
        },
        "source_candidate_status": {
          "type": "string"
        },
        "source_packet_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "provider_preflight_ref": {
      "$ref": "#/$defs/provider_preflight_ref"
    },
    "retry_waiver_approval_ref": {
      "$ref": "#/$defs/ref"
    },
    "mar_start_approval_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_ref",
        "task_id",
        "run_id",
        "requested_at",
        "lane_id",
        "provider_id",
        "provider_registry_sha256",
        "input_bundle_sha256",
        "review_git_head",
        "bound_tuple"
      ],
      "properties": {
        "approval_ref": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "lane_id": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        },
        "provider_registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_bundle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "review_git_head": {
          "type": "string"
        },
        "bound_tuple": {
          "$ref": "#/$defs/mar_start_bound_tuple"
        }
      }
    },
    "policy_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concurrency_policy_ref",
        "duration_policy_ref",
        "cost_policy_ref",
        "independence_policy_ref",
        "execution_safety_ref"
      ],
      "properties": {
        "concurrency_policy_ref": {
          "$ref": "#/$defs/ref"
        },
        "duration_policy_ref": {
          "$ref": "#/$defs/ref"
        },
        "cost_policy_ref": {
          "$ref": "#/$defs/ref"
        },
        "independence_policy_ref": {
          "$ref": "#/$defs/ref"
        },
        "execution_safety_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "independence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_independence_required",
        "shared_author_backend_allowed",
        "correlation_review_required"
      ],
      "properties": {
        "reviewer_independence_required": {
          "const": true
        },
        "shared_author_backend_allowed": {
          "const": false
        },
        "correlation_review_required": {
          "const": true
        }
      }
    },
    "execution_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_evidence_only",
        "block_unsafe_provider_execution",
        "no_semantic_prompt_generation",
        "safe_ref_policy"
      ],
      "properties": {
        "candidate_evidence_only": {
          "const": true
        },
        "block_unsafe_provider_execution": {
          "const": true
        },
        "no_semantic_prompt_generation": {
          "const": true
        },
        "safe_ref_policy": {
          "const": "repo_relative_only"
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/safe_relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safe_relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
      "not": {
        "pattern": "^[A-Za-z]:"
      }
    },
    "provider_preflight_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "valid_through_request_ts"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/safe_relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "valid_through_request_ts": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "mar_start_bound_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_schema_ref",
        "role_matrix_ref",
        "prompt_refs_sha256",
        "required_roles",
        "provider_lane_id",
        "provider_id",
        "adapter_type",
        "provider_registry_ref",
        "provider_correlation_ref",
        "provider_provenance_ref",
        "provider_preflight_ref",
        "required_capabilities",
        "execution_policy_refs",
        "approval_metadata_ref",
        "approved_tuple_checksum",
        "approval_expires_at",
        "retry_waiver_approval_ref",
        "input_bundle_ref",
        "task_id",
        "run_id",
        "request_bundle_schema_version",
        "request_bundle_ref",
        "prompt_bundle_refs",
        "provider_registry_schema_version",
        "provider_family",
        "adapter_proof_ref",
        "author_backend_correlation",
        "provider_preflight",
        "execution_policy_values",
        "approval_metadata"
      ],
      "properties": {
        "request_schema_ref": {
          "$ref": "#/$defs/ref"
        },
        "role_matrix_ref": {
          "$ref": "#/$defs/ref"
        },
        "prompt_refs_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "required_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provider_lane_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "adapter_type": {
          "enum": [
            "kah_mar",
            "fixture_only"
          ]
        },
        "provider_registry_ref": {
          "$ref": "#/$defs/ref"
        },
        "provider_correlation_ref": {
          "$ref": "#/$defs/ref"
        },
        "provider_provenance_ref": {
          "$ref": "#/$defs/ref"
        },
        "provider_preflight_ref": {
          "$ref": "#/$defs/provider_preflight_ref"
        },
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "execution_policy_refs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "concurrency_policy_ref",
            "duration_policy_ref",
            "cost_policy_ref",
            "independence_policy_ref",
            "execution_safety_ref"
          ],
          "properties": {
            "concurrency_policy_ref": {
              "$ref": "#/$defs/ref"
            },
            "duration_policy_ref": {
              "$ref": "#/$defs/ref"
            },
            "cost_policy_ref": {
              "$ref": "#/$defs/ref"
            },
            "independence_policy_ref": {
              "$ref": "#/$defs/ref"
            },
            "execution_safety_ref": {
              "$ref": "#/$defs/ref"
            }
          }
        },
        "approval_metadata_ref": {
          "$ref": "#/$defs/ref"
        },
        "approved_tuple_checksum": {
          "$ref": "#/$defs/sha256"
        },
        "approval_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "retry_waiver_approval_ref": {
          "$ref": "#/$defs/ref"
        },
        "input_bundle_ref": {
          "$ref": "#/$defs/ref"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "request_bundle_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "request_bundle_ref": {
          "$ref": "#/$defs/ref"
        },
        "prompt_bundle_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/prompt_bundle_ref"
          }
        },
        "provider_registry_schema_version": {
          "const": "mar.role_lanes.v1"
        },
        "provider_family": {
          "type": "string",
          "minLength": 1
        },
        "adapter_proof_ref": {
          "$ref": "#/$defs/ref"
        },
        "author_backend_correlation": {
          "$ref": "#/$defs/author_backend_correlation_tuple"
        },
        "provider_preflight": {
          "$ref": "#/$defs/provider_preflight_tuple"
        },
        "execution_policy_values": {
          "$ref": "#/$defs/execution_policy_tuple"
        },
        "approval_metadata": {
          "$ref": "#/$defs/approval_metadata_tuple"
        }
      }
    },
    "prompt_bundle_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/safe_relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "author_backend_correlation_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author_backend_id",
        "author_backend_family",
        "author_session_ref",
        "author_thread_ref",
        "author_turn_ref",
        "correlation_status",
        "independence_policy_ref"
      ],
      "properties": {
        "author_backend_id": {
          "type": "string",
          "minLength": 1
        },
        "author_backend_family": {
          "type": "string",
          "minLength": 1
        },
        "author_session_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "author_thread_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "author_turn_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "correlation_status": {
          "type": "string",
          "minLength": 1
        },
        "independence_policy_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "provider_preflight_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "generated_at",
        "expires_at",
        "checked_binary_version",
        "checked_capability_version"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "checked_binary_version": {
          "type": "string",
          "minLength": 1
        },
        "checked_capability_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution_policy_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_concurrency",
        "max_duration",
        "max_cost_or_token_budget",
        "raw_output_cap",
        "secret_scan_redaction_required",
        "mutation_guard_required",
        "safety_policy_ref"
      ],
      "properties": {
        "max_concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "max_duration": {
          "type": "string",
          "minLength": 1
        },
        "max_cost_or_token_budget": {
          "type": "string",
          "minLength": 1
        },
        "raw_output_cap": {
          "type": "string",
          "minLength": 1
        },
        "secret_scan_redaction_required": {
          "const": true
        },
        "mutation_guard_required": {
          "const": true
        },
        "safety_policy_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "approval_metadata_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_posture",
        "approver_id",
        "approval_ref_id",
        "approval_scope",
        "approved_tuple_checksum",
        "approval_created_at",
        "approval_expires_at",
        "retry_waiver_approval_ref",
        "null_validation_posture"
      ],
      "properties": {
        "approval_posture": {
          "enum": [
            "approved",
            "validation_only"
          ]
        },
        "approver_id": {
          "type": "string",
          "minLength": 1
        },
        "approval_ref_id": {
          "type": "string",
          "minLength": 1
        },
        "approval_scope": {
          "type": "string",
          "minLength": 1
        },
        "approved_tuple_checksum": {
          "$ref": "#/$defs/sha256"
        },
        "approval_created_at": {
          "type": "string",
          "format": "date-time"
        },
        "approval_expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "retry_waiver_approval_ref": {
          "$ref": "#/$defs/ref"
        },
        "null_validation_posture": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
